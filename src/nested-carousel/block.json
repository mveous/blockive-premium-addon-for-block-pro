		"arrowHoverBgColor": {
			"type": "string",
			"default": ""
		},
		"dotSize": {
			"type": "number",
			"default": 10
		},
		"dotColor": {
			"type": "string",
			"default": ""
		},
		"dotActiveColor": {
			"type": "string",
			"default": ""
		},
		"bpafbUid": {
			"type": "string",
			"default": ""
