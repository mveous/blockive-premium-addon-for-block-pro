		"bpafbHideMobile": {
			"type": "boolean",
			"default": false
		},
		"bpafbAnimationType": {
			"type": "string",
			"default": "none"
		},
		"bpafbAnimationDuration": {
			"type": "number",
			"default": 800
		},
		"bpafbAnimationDelay": {
			"type": "number",
			"default": 0
