		"source": {
			"type": "string",
			"default": "recent"
		},
		"categories": {
			"type": "array",
			"items": {
				"type": "number"
			},
			"default": []
		},
		"tags": {
			"type": "array",
			"items": {
				"type": "number"
			},
			"default": []
