			"type": "string",
			"default": ""
		},
		"listStyle": {
			"type": "string",
			"default": "disc"
		},
		"bpafbUid": {
			"type": "string",
			"default": ""
		},
		"bpafbDisplay": {
			"type": "string",
			"default": ""
