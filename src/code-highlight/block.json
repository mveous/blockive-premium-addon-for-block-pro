			"type": "string",
			"default": ""
		},
		"bpafbContainerBoxShadow": {
			"type": "boolean",
			"default": false
		},
		"bpafbContainerShadowColor": {
			"type": "string",
			"default": "rgba(0,0,0,0.15)"
		},
		"bpafbContainerShadowBlur": {
			"type": "number",
			"default": 15
		},
		"bpafbContainerShadowSpread": {
			"type": "number",
			"default": 0
		},
		"bpafbContainerHoverBoxShadow": {
			"type": "boolean",
			"default": false
		},
		"bpafbContainerHoverShadowColor": {
			"type": "string",
			"default": "rgba(0,0,0,0.15)"
		},
		"bpafbContainerHoverShadowBlur": {
			"type": "number",
			"default": 15
		},
		"bpafbContainerHoverShadowSpread": {
			"type": "number",
			"default": 0
		},
