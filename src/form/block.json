{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blockive-premium-addon-for-block/form",
	"version": "1.0.0",
	"title": "Form",
	"category": "bpafb-widgets",
	"icon": "feedback",
	"description": "A contact or lead form: fields, email notifications, saved submissions, redirect, and webhook, with built-in spam protection.",
	"keywords": [
		"form",
		"contact",
		"email",
		"lead",
		"submission",
		"subscribe"
	],
	"textdomain": "blockive-premium-addon-for-block-pro",
	"attributes": {
		"formId": {
			"type": "string",
			"default": ""
		},
		"formName": {
			"type": "string",
			"default": "Contact form"
		},
		"fields": {
			"type": "array",
			"default": [
				{
					"id": "name",
					"type": "text",
					"label": "Name",
					"required": true,
					"width": "50"
				},
				{
					"id": "email",
					"type": "email",
					"label": "Email",
					"required": true,
					"width": "50"
				},
				{
					"id": "message",
					"type": "textarea",
					"label": "Message",
					"required": true,
					"width": "100",
					"rows": 5
				}
			]
		},
		"submitText": {
			"type": "string",
			"default": "Send"
		},
		"buttonAlign": {
			"type": "string",
			"default": "left"
		},
		"showLabels": {
			"type": "boolean",
			"default": true
		},
		"requiredMark": {
			"type": "boolean",
			"default": true
		},
		"actionSave": {
			"type": "boolean",
			"default": true
		},
		"actionEmail": {
			"type": "boolean",
			"default": true
		},
		"emailTo": {
			"type": "string",
			"default": ""
		},
		"emailSubject": {
			"type": "string",
			"default": ""
		},
		"emailMessage": {
			"type": "string",
			"default": "[all-fields]"
		},
		"actionRedirect": {
			"type": "boolean",
			"default": false
		},
		"redirectUrl": {
			"type": "string",
			"default": ""
		},
		"actionWebhook": {
			"type": "boolean",
			"default": false
		},
		"webhookUrl": {
			"type": "string",
			"default": ""
		},
		"successMessage": {
			"type": "string",
			"default": "Thanks! Your message has been sent."
		},
		"errorMessage": {
			"type": "string",
			"default": "Something went wrong. Please try again."
		},
		"requiredMessage": {
			"type": "string",
			"default": "This field is required."
		},
		"columnGap": {
			"type": "number",
			"default": 16
		},
		"rowGap": {
			"type": "number",
			"default": 16
		},
		"labelColor": {
			"type": "string",
			"default": ""
		},
		"fieldColor": {
			"type": "string",
			"default": ""
		},
		"fieldBgColor": {
			"type": "string",
			"default": ""
		},
		"fieldBorderColor": {
			"type": "string",
			"default": ""
